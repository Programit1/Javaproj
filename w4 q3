package lab4;

class CollegeStudent {
    int studentId;
    String name;

    static String collegeName = "Alliance University";

    CollegeStudent(int studentId, String name) {
        this.studentId = studentId;
        this.name = name;
    }

    void displayDetails() {
        System.out.println("Student ID: " + studentId);
        System.out.println("Name: " + name);
        System.out.println("College Name: " + collegeName);
    }
}

public class StaticDemo {
    public static void main(String[] args) {

        CollegeStudent s1 = new CollegeStudent(101, "Rahul");
        CollegeStudent s2 = new CollegeStudent(102, "Priya");
        CollegeStudent s3 = new CollegeStudent(103, "Aman");

        s1.displayDetails();
        s2.displayDetails();
        s3.displayDetails();
    }
}
